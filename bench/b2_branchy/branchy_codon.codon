"""Codon implementations of the RQ2 branchy kernels, built ahead of time by `codon build -pyext`."""
# `_build` and `_check` are nested inside `binarytrees` on purpose: -pyext exports every
# top-level function, and a top-level helper taking a `Node` fails the build outright.


# Do not delete the next import: it registers ndarray's Python conversions, and without it the
# -pyext build cannot realise `tokenize` at all.
import numpy.pybridge
import numpy as np

DIGIT = 1
ALPHA = 2
OTHER = 3


class Node:
    left: Optional[Node]
    right: Optional[Node]

    def __init__(self, left: Optional[Node], right: Optional[Node]):
        self.left = left
        self.right = right


def tokenize(data: np.ndarray[u8, 1], n: int) -> Tuple[int, int]:
    # Declaring this argument as `str` also compiles and is also correct, but it makes the
    # wrapper copy the whole input on every call, which is not what the other rows measure.
    tokens = 0
    checksum = 0
    state = 0
    p = data.data
    for i in range(n):
        ch = int(p[i])
        if 48 <= ch <= 57:
            if state != DIGIT:
                tokens += 1
                state = DIGIT
            checksum += ch - 48
        elif (65 <= ch <= 90) or (97 <= ch <= 122):
            if state != ALPHA:
                tokens += 1
                state = ALPHA
            checksum += (ch | 32) - 96
        elif ch == 32 or ch == 10 or ch == 9:
            state = 0
        else:
            if state != OTHER:
                tokens += 1
                state = OTHER
            checksum += 7
    return (tokens, checksum)


def binarytrees(depth: int) -> int:
    def _build(d: int) -> Optional[Node]:
        if d == 0:
            return None
        return Node(_build(d - 1), _build(d - 1))

    def _check(node: Optional[Node]) -> int:
        if node is None:
            return 0
        return 1 + _check(node.left) + _check(node.right)

    return _check(_build(depth))


def bfs(n: int, start: int) -> int:
    dist = [-1 for _ in range(n)]
    q = [0 for _ in range(n)]
    dist[start] = 0
    q[0] = start
    head = 0
    tail = 1
    total = 0
    while head < tail:
        u = q[head]
        head += 1
        du = dist[u]
        total += du
        for m, a in ((7, 3), (13, 5), (29, 11)):
            v = (u * m + a) % n
            if dist[v] < 0:
                dist[v] = du + 1
                q[tail] = v
                tail += 1
    return total
